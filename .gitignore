# LaTeX build
paper/build/
*.aux
*.log
*.bbl
*.blg
*.bcf
*.run.xml
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.swp

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Data (fetched, verified by SHA256SUMS)
data/raw/*
!data/raw/.gitkeep

# Heavy results (regenerable); results.json IS committed
results/chains/
results/sims/
*.npz
*.h5

# Build artifact: make_release.py rebuilds it from the tree, and a committed
# copy would be a second, silently stale version of the whole repository.
release/

# arXiv bundle: make_arxiv.py rebuilds it; a committed copy is a stale
# submission sitting next to the live one.
build/

# The deposit archive, rebuilt by make_release.py
release_bundle.zip
